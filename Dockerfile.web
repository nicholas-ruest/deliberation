FROM node:26.6.0-alpine3.23@sha256:b528fccffe400ce6162162f70777bdfcd8439aa1affc2e8e2d66a0db2e018378 AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.build.json ./
RUN npm ci --ignore-scripts
COPY src ./src
RUN npm run build

FROM node:26.6.0-alpine3.23@sha256:b528fccffe400ce6162162f70777bdfcd8439aa1affc2e8e2d66a0db2e018378
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist
USER 10001:10001
EXPOSE 3001
CMD ["node", "dist/apps/web.js"]
