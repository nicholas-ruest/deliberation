FROM node:24.14.0-alpine3.23@sha256:2c9dfc20be9c57d7409e40b61f4806afbae4d5b5bb6be166a24e3a3a803869a5 AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.build.json ./
RUN npm ci --ignore-scripts
COPY src ./src
RUN npm run build

FROM node:24.14.0-alpine3.23@sha256:2c9dfc20be9c57d7409e40b61f4806afbae4d5b5bb6be166a24e3a3a803869a5
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist
USER 10001:10001
EXPOSE 3001
CMD ["node", "dist/apps/web.js"]
